# Extracted game data is NOT redistributed. Per ADR-0014 and 03-data-ingestion.md §7,
# extraction from a game you own supports a personal tool; republishing it as a dataset
# is a different act. This repo is public, so all game-derived content stays local and
# is regenerated by running tools/ingest against your own install.
data/raw/
data/1.0.2/
data/*.csv

# Voice recordings for the STT evaluation. Personal data, and this repo is public.
data/stt_eval/*/
!data/stt_eval/prompts.json

# Local config: contains absolute paths to the game install and save directory
config.local.*
.env
*.secrets.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# .NET
bin/
obj/

# pytest
.pytest_cache/
Notes/