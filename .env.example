# Copy to .env and fill in. .env is gitignored - this repo is public.
#
#   copy .env.example .env
#
# Real environment variables take precedence over anything here, so an exported
# variable always wins. Values are read at import; restart after editing.

# --- intent router -----------------------------------------------------------
# Only needed for --router claude. Without it, the pipeline falls back to the
# deterministic stub router and logs that it did so.
# An `ant auth login` profile works instead of a key, and needs nothing here.
ANTHROPIC_API_KEY=

# --- Discord -----------------------------------------------------------------
# Alternative to putting these in config.local.toml. Either location works;
# these override the file.
# PALINTEL_DISCORD_TOKEN=
# PALINTEL_CHANNEL_ID=

# --- data --------------------------------------------------------------------
# Which extracted dataset to load, matching a directory under data/.
# PALINTEL_DATA_VERSION=1.0.2
